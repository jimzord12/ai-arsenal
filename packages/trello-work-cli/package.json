{
  "name": "@jz/ai-arsenal-trello-work-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Private Trello REST API v1 Work Unit CLI.",
  "type": "module",
  "bin": {
    "work": "src/bin.ts"
  },
  "exports": {},
  "files": [
    "assets/work-guide.md",
    "assets/work-unit-metadata.schema.json",
    "src/bin.ts",
    "src/checklist.ts",
    "src/cli.ts",
    "src/command-catalog.ts",
    "src/config.ts",
    "src/create.ts",
    "src/docs.ts",
    "src/errors.ts",
    "src/mutation.ts",
    "src/read-commands.ts",
    "src/reconcile.ts",
    "src/reference.ts",
    "src/transition.ts",
    "src/trello-client.ts",
    "src/trello-types.ts",
    "src/update.ts",
    "src/version.ts",
    "src/work-unit.ts",
    "README.md"
  ],
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "jest --runInBand --coverage",
    "pack": "pnpm pack",
    "validate": "publint --strict --pack pnpm"
  }
}
