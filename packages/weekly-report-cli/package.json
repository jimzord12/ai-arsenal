{
  "name": "@jz/ai-arsenal-weekly-report-cli",
  "version": "0.1.1",
  "private": true,
  "description": "Generic deterministic evidence CLI for weekly engineering reports.",
  "type": "module",
  "bin": {
    "weekly-report-cli": "dist/bin.js"
  },
  "exports": {},
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "24"
  },
  "scripts": {
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "pnpm run build && jest --runInBand --coverage",
    "test:distribution": "jest --runInBand --coverage=false --runTestsByPath test/distribution.e2e.test.ts",
    "prepack": "pnpm run build",
    "pack": "pnpm pack",
    "validate": "publint --strict --pack pnpm"
  }
}
